# ---------------------------------------------------------------------------
# Nya(AI) environment configuration
# Copy this file to `.env` in /backend and fill in what you have.
# The system runs fully offline in "mock" mode with no keys at all.
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# "mock"      -> local, deterministic, extractive/grounded analysis (default,
#                no API key needed, safe for demos, never invents facts)
# "gemini"    -> Google Gemini API (requires GEMINI_API_KEY)
# "anthropic" -> real Claude model calls (requires ANTHROPIC_API_KEY)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Embedding provider -------------------------------------------------
# "local" -> deterministic hashing-based text embeddings, no network/API
#            required. Swap in a real embedding API later via the
#            EmbeddingProvider abstraction (see backend/app/services/embeddings.py)
# "sentence-transformers" -> Use local BERT model (default: all-MiniLM-L6-v2)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Retrieval Configuration --------------------------------------------
TOP_K=5
RERANK_TOP_K=3

# --- Database ----------------------------------------------------------
# SQLite file DB by default. Point this at a Postgres URL to scale later,
# e.g. postgresql+psycopg2://user:pass@localhost:5432/nya
DATABASE_URL=sqlite:///./data/nya.db

# --- App -----------------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
